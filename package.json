{
  "name": "lp-player",
  "version": "1.0.0",
  "description": "LP Player — Local Project Manager. A centralized dashboard for managing, installing, and running local development applications.",
  "type": "module",
  "bin": {
    "lp-player": "./bin/lp-player.js"
  },
  "files": [
    "bin/",
    "dist/",
    "server.cjs",
    "server/services/",
    "src/data/",
    "package.json"
  ],
  "pkg": {
    "assets": [
      "dist/**/*",
      "src/data/**/*",
      "server/services/**/*.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "local",
    "project",
    "manager",
    "dashboard",
    "development",
    "tools",
    "terminal",
    "process-manager"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "server": "cd server && node index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "concurrently \"npm run dev\" \"npm run api\"",
    "api": "LP_PLAYER_DATA_DIR=./src/data node server.js",
    "dev:api": "concurrently \"npm run dev\" \"npm run api\"",
    "prod:preview": "concurrently \"npm run preview\" \"npm run api\"",
    "prod": "npm run build && LP_PLAYER_DATA_DIR=./src/data node server.cjs"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.2.0",
    "cors": "^2.8.5",
    "env-paths": "^4.0.0",
    "express": "^4.18.2",
    "framer-motion": "^11.18.2",
    "ping": "^0.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.4.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@yao-pkg/pkg": "^6.14.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "into-stream": "^6.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.0.8"
  },
  "overrides": {
    "@yao-pkg/pkg": {
      "into-stream": "6.0.0"
    }
  }
}
